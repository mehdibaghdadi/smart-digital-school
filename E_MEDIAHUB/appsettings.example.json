{
  "AllowedOrigins": [ "https://your-domain.example" ],
  "AppSettings": {
    "AppTitle": "Smart Digital School : MEDIA HUB",
    "MaxContentLength": 524288000,
    "BufferSizeDownload": 65536,
    "PreviewPercent": 0.5,
    "SecretKey": "CHANGE_ME",
    "TokenApi": "CHANGE_ME",
    "E_DbFilesRoot": "/path/to/E_DBFILES/",
    "AcceptDomains": [ "://localhost", "://127.0.0.1" ]
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "Serilog": {
    "MinimumLevel": { "Default": "Error" },
    "WriteTo": [ { "Name": "File", "Args": { "path": "./Logs/log-.txt", "rollingInterval": "Day" } } ]
  },
  "AllowedHosts": "*"
}
