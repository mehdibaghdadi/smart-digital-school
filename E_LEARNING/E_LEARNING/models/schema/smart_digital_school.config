upstream E_LEARNING {
    server 127.0.0.1:5100;
}

upstream E_GATEWAY {
    server 127.0.0.1:5120;
}

upstream E_MEDIAHUB{
    server 127.0.0.1:5110;
}

upstream E_PAYMENT{
    server 127.0.0.1:5123;
}

upstream E_SIGNALR{
    server 127.0.0.1:5122;
}

upstream E_WEBSITE{
    server 127.0.0.1:5121;
}


# ----------------------------------- E_LEARNING -------------------------------
server {
    listen 8443 ssl;  
    server_name localhost;

    # Emplacement des certificats SSL pour localhost
    ssl_certificate     C:/nginx/servers/certificats/sds/certificate.pem;  
    ssl_certificate_key C:/nginx/servers/certificats/sds/private_key.pem;  
	
	# Fichiers de log pour le serveur HTTPS
    error_log   C:/nginx/servers/logs/e_learning_error.log;   # Log des erreurs

    # Gestion des requêtes HTTPS
    location / {
        proxy_pass http://E_LEARNING;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

}

server {
    listen 8083;
    server_name localhost;

    location / {
        return 301 https://$host:8443$request_uri;
    }
}

# ----------------------------------- E_GATEWAY -------------------------------
server {
    listen 8444 ssl;  
    server_name localhost;
	client_max_body_size 200M;

    # Emplacement des certificats SSL pour localhost
    ssl_certificate     C:/nginx/servers/certificats/sds/certificate.pem;  
    ssl_certificate_key C:/nginx/servers/certificats/sds/private_key.pem;  
	
	# Fichiers de log pour le serveur HTTPS
    error_log   C:/nginx/servers/logs/e_gateway_error.log;   # Log des erreurs

    # Gestion des requêtes HTTPS
    location / {
        proxy_pass http://E_GATEWAY;
        # En-têtes pour transmettre les informations de la requête d'origine
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Autres paramètres proxy recommandés pour les API .NET Core
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_buffering off;
    }

}

# ----------------------------------- E_MEDIAHUB -------------------------------
server {
    listen 8445 ssl;  
    server_name localhost;
	
	# Limite de taille d'upload pour autoriser des fichiers plus volumineux
	client_max_body_size 1000M;

    # Emplacement des certificats SSL pour localhost
    ssl_certificate     C:/nginx/servers/certificats/sds/certificate.pem;  
    ssl_certificate_key C:/nginx/servers/certificats/sds/private_key.pem;  
	
	# Fichiers de log pour le serveur HTTPS
    error_log   C:/nginx/servers/logs/e_mediahub_error.log;   # Log des erreurs

    # Gestion des requêtes HTTPS
    location / {
        proxy_pass http://E_MEDIAHUB;
        # En-têtes pour transmettre les informations de la requête d'origine
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Autres paramètres proxy recommandés pour les API .NET Core
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_buffering off;
    }

}

# ----------------------------------- E_PAYMENT -------------------------------
server {
    listen 8446 ssl;  
    server_name localhost;

    # Emplacement des certificats SSL pour localhost
    ssl_certificate     C:/nginx/servers/certificats/sds/certificate.pem;  
    ssl_certificate_key C:/nginx/servers/certificats/sds/private_key.pem;  
	
	# Fichiers de log pour le serveur HTTPS
    error_log   C:/nginx/servers/logs/e_payment_error.log;   # Log des erreurs

    # Gestion des requêtes HTTPS
    location / {
        proxy_pass http://E_PAYMENT;
        # En-têtes pour transmettre les informations de la requête d'origine
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Autres paramètres proxy recommandés pour les API .NET Core
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_buffering off;
    }

}

# ----------------------------------- E_SIGNALR -------------------------------
server {
    listen 8447 ssl;
    server_name localhost;

    # Emplacement des certificats SSL pour localhost
    ssl_certificate     C:/nginx/servers/certificats/sds/certificate.pem;
    ssl_certificate_key C:/nginx/servers/certificats/sds/private_key.pem;

    # Fichiers de log pour le serveur HTTPS
    error_log   C:/nginx/servers/logs/e_signalr_error.log;
    access_log  C:/nginx/servers/logs/e_signalr_access.log;

    # Gestion des requêtes HTTPS
    location / {
        proxy_pass http://E_SIGNALR;

        # En-têtes pour transmettre les informations de la requête d'origine
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Autres paramètres proxy pour gérer les connexions WebSocket de SignalR
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";  # "Upgrade" est crucial pour WebSocket
        proxy_read_timeout 86400s;              # Timeout étendu pour les connexions longues de SignalR
        proxy_send_timeout 86400s;
        proxy_buffering off;                    # Désactiver le buffering pour des réponses immédiates
    }
}


# ----------------------------------- E_WEBSITE -------------------------------
server {
    listen 8448 ssl;  
    server_name localhost;

    # Emplacement des certificats SSL pour localhost
    ssl_certificate     C:/nginx/servers/certificats/sds/certificate.pem;  
    ssl_certificate_key C:/nginx/servers/certificats/sds/private_key.pem;  
	
	# Fichiers de log pour le serveur HTTPS
    error_log   C:/nginx/servers/logs/e_website_error.log;   # Log des erreurs

    # Gestion des requêtes HTTPS
    location / {
        proxy_pass http://E_WEBSITE;
        # En-têtes pour transmettre les informations de la requête d'origine
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Autres paramètres proxy recommandés pour les API .NET Core
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_buffering off;
    }

}


