<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>507fcc7b-8d0a-4bc7-a0ce-6ca282c66d22</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>runserver.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>E_AI_COURSE</Name>
    <RootNamespace>E_AI_COURSE</RootNamespace>
    <InterpreterId>MSBuild|env|$(MSBuildProjectFullPath)</InterpreterId>
    <LaunchProvider>Web launcher</LaunchProvider>
    <WebBrowserUrl>http://localhost</WebBrowserUrl>
    <WebBrowserPort>8800</WebBrowserPort>
    <PythonRunWebServerCommand>D:\SMART_DIGITAL_SCHOOL\E_LEARNING\E_AI_COURSE\env\Scripts\uvicorn.exe</PythonRunWebServerCommand>
    <PythonRunWebServerCommandArguments>main:app --reload --port 8800</PythonRunWebServerCommandArguments>
    <PythonRunWebServerCommandEnvironment>./.env</PythonRunWebServerCommandEnvironment>
    <PythonRunWebServerCommandType>script</PythonRunWebServerCommandType>
    <SuppressConfigureTestFrameworkPrompt>true</SuppressConfigureTestFrameworkPrompt>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="E_AI_COURSE\app\ai.py" />
    <Compile Include="E_AI_COURSE\prompts\course_generator.py.back" />
    <Compile Include="E_AI_COURSE\prompts\course_generator.py" />
    <Compile Include="E_AI_COURSE\app\schemas.py" />
    <Compile Include="E_AI_COURSE\app\__init__.py" />
    <Compile Include="E_AI_COURSE\prompts\__init__.py" />
    <Compile Include="E_AI_COURSE\routers\generate_course.py" />
    <Compile Include="E_AI_COURSE\routers\model_status.py" />
    <Compile Include="E_AI_COURSE\routers\__init__.py" />
    <Compile Include="E_AI_COURSE\test\test_generate.py" />
    <Compile Include="E_AI_COURSE\utilities\helpers.py" />
    <Compile Include="E_AI_COURSE\utilities\__init__.py" />
    <Compile Include="E_AI_COURSE\__init__.py" />
    <Compile Include="runserver.py" />
    <Compile Include="E_AI_COURSE\settings.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="E_AI_COURSE\app\" />
    <Folder Include="E_AI_COURSE\" />
    <Folder Include="E_AI_COURSE\prompts\" />
    <Folder Include="E_AI_COURSE\test\" />
    <Folder Include="E_AI_COURSE\utilities\" />
    <Folder Include="E_AI_COURSE\routers\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include=".env" />
    <Content Include="Dockerfile" />
    <Content Include="requirements.txt" />
    <Content Include="launcher.bat" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="env\">
      <Id>env</Id>
      <Version>3.11</Version>
      <Description>env (Python 3.11 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>